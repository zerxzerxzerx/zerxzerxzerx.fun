# Discord bot token — used to look up user info for the Discord profile modal.
#
# How to get one (takes 2 minutes, free, no approval needed):
#   1. Go to https://discord.com/developers/applications
#   2. Click "New Application" — name it anything (e.g. "zerxbio")
#   3. Open the "Bot" tab, click "Reset Token", copy the token
#   4. Paste it below and save this file as .env.local
#   5. Restart the dev server
#
# The bot doesn't need to join any server. The token only calls the /users/:id
# endpoint, which requires no permissions or scopes.
DISCORD_BOT_TOKEN=

# Etherscan API key — used by the wallet portfolio modal (lib/wallet/*) for
# ETH-mainnet USDT/USDC balances and recent transfer history. Optional: if
# unset, the modal still works via public JSON-RPC fallback (lib/wallet/rpc.ts),
# just with a much shorter (~1.3 day) activity lookback window since free
# anonymous RPC providers cap eth_getLogs to recent, non-archive blocks.
# Free tier is 5 req/s, far more than this single-wallet feature needs.
#
# Grab one at https://etherscan.io/myapikey (sign up, hit "Add", copy).
ETHERSCAN_KEY=

# Wallet address shown in the wallet portfolio modal — optional, defaults to
# the address hardcoded in lib/wallet/config.ts if unset. It's a public
# Ethereum address (not a secret), but kept server-side-only and out of
# lib/constants.ts on purpose: the API route and client component never see
# or expose the raw address, only a scrubbed balance/activity summary.
WALLET_ADDRESS=

# Helius API key — optional, currently unused by any feature in this repo.
# Free tier at https://helius.dev if a future SOL-based feature needs it.
HELIUS_KEY=
